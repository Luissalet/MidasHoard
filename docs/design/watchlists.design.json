      "css": ".ds-panel{font-family:var(--hoard-font-sans,\"Source Sans 3\",sans-serif);background:var(--hoard-surface,#24221b);border:1px solid var(--hoard-border,#433f35);border-radius:var(--hoard-radius-lg,10px);padding:12px;color:var(--hoard-text,#eceae1);font-size:13px;line-height:1.5}.ds-panel h2{margin:0;font-size:14px;font-weight:650;letter-spacing:-.01em}.ds-panel p{margin:12px 0 0;font-size:12px;color:var(--hoard-text-muted,#bebbb4)}"
